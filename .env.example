# Copy to .env and fill in. .env is gitignored and holds local secrets.

# LoRa channel pre-shared keys, one per channel. Each deployment file names the
# variable holding each channel's key (radio.channels[].psk_env); the key must
# be identical on every radio of that mesh. Format: base64:<key>. Generate a
# key once per channel, replace the whole value with what it prints, and share
# it only with whoever provisions that mesh. Any OS, no extra tools:
#     python -c "import secrets,base64;print('base64:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# (On Linux and macOS, `openssl rand -base64 32` also works, but it prints the
# key without the `base64:` prefix, which you then have to add yourself.)
# Each variable once: if a name appears twice, the FIRST value is used.
# Read only by `configure.py provision` and `configure.py inspect`; validation,
# decoding and the channel-study receiver do not need them.

# deployments/rapa-nui.yaml
EASTERNET_TELEMETRY_PSK=base64:CHANGE_ME
EASTERNET_MSG_PSK=base64:CHANGE_ME

# deployments/mini.yaml
MINI_PSK=base64:CHANGE_ME

# deployments/san-joaquin.yaml, deployments/bench-lilygo.yaml
LORA_TELEMETRY_CHANNEL_PSK=base64:CHANGE_ME
LORA_MSG_CHANNEL_PSK=base64:CHANGE_ME

# BLE pairing PIN, one per deployment that declares radio.ble_pin_env. Six
# digits, identical on every radio of that mesh, and NOT 123456: that is the
# default the firmware writes on a board with no screen, and it is published in
# Meshtastic's own documentation, so out of the box anyone within BLE range can
# pair with a node and reconfigure it from the app. Replace the example below.
# Pick one that is not a date or a sequence, on any OS:
#     python -c "import secrets;print(f'{secrets.randbelow(10**6):06d}')"
# Read only by `configure.py provision` and `configure.py inspect`, which
# compare it without ever printing it.
RAPA_NUI_BLE_PIN=481902

# Optional: select a deployment for every tool instead of passing --deployment.
# There is deliberately no default.
# MESH_DEPLOYMENT=

# Optional: who records channel-study sessions (written to session.json).
# MESH_OPERATOR=
